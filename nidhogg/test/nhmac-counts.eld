;; nhmac-counts.eld --- Naglfar's frozen stat counts (plan Task 35 step 3)  -*- mode: lisp-data -*-
;;
;; Each (ROW KEY N): the growth of `nhmac-stats' counter KEY that row ROW reads through `nhmac-gui--delta', the same
;; at scale 1 and 2 in rounds 8 and 9 (CI runs 43307562030 and 43323838755).  A row that reads a different value
;; fails naming the count.  Counts that vary with the runner's speed (pumps, waits, kq wakes, bytes copied, pacer
;; fires) and the commit row's (timed by its deadline) are not frozen.  Refreshed from the GUI lane's
;; GLITNIR_GUI_OUT/nhmac-counts.eld, which records every count a row reads.
(
 (glitnir-nhmac/stats-count-the-commits :commits 5)
 (nhmac-burst-last-frame-shows :held 1)
 (nhmac-burst-last-frame-shows :held-timeouts 0)
 (nhmac-burst-last-frame-shows :surface-busy 0)
 (nhmac-child-move :commits 1)
 (nhmac-child-move :draws 0)
 (nhmac-child-move :overhang-switches 0)
 (nhmac-child-move :props-bounds 0)
 (nhmac-child-move :props-contents 0)
 (nhmac-child-move :props-hidden 0)
 (nhmac-child-move :props-host 0)
 (nhmac-child-move :props-opacity 0)
 (nhmac-child-move :props-order 0)
 (nhmac-child-move :props-position 1)
 (nhmac-draw-other-thread :deferred-commits 1)
 (nhmac-font-calls-per-glyph :font-fills 3)
 (nhmac-glyphs-measured-once :font-calls 0)
 (nhmac-held-commit-bound :commits 1)
 (nhmac-held-commit-bound :deadline-flushes 0)
 (nhmac-held-commit-bound :held-timeouts 1)
 (nhmac-held-commit-bound :surface-busy 1)
 (nhmac-key-to-commit-counts :commits 1)
 (nhmac-key-to-commit-counts :pumps 1)
 (nhmac-key-to-commit-counts :sleeps 0)
 (nhmac-keys-before-output :helper-hops-keys 0)
 (nhmac-kq-fds :empty-wakes 0)
 (nhmac-lock-handoff :parks-with-waiters 0)
 (nhmac-motion-no-redisplay :commits 0)
 (nhmac-motion-no-redisplay :draws 0)
 (nhmac-overhang-switch :draws 0)
 (nhmac-overhang-switch :overhang-switches 2)
 (nhmac-overhang-switch :panel-orders 2)
 (nhmac-pacer-idle-disarmed :pacer-arms 1)
 (nhmac-pacer-idle-disarmed :pacer-fires 0)
 (nhmac-parent-frame-changes :draws 0)
