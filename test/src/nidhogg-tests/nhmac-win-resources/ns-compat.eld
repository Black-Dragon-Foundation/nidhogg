;; -*- lexical-binding: t -*-
;; The ns-* functions and variables NS defines in C (src/nsfns.m, nsselect.m, nsmenu.m, nsterm.m, nsfont.m),
;; read from the Nidhogg sources at the Naglfar base.  Functions: (NAME MIN-ARGS MAX-ARGS); variables: (NAME . DEFAULT),
;; with DEFAULT :string for `ns-version-string' (any string).  `nhmac-win.el' defines every one.
(
 :functions (
  (ns-badge 1 1)
  (ns-begin-drag 3 6)
  (ns-block-system-sleep 2 2)
  (ns-disown-selection-internal 1 1)
  (ns-display-monitor-attributes-list 0 1)
  (ns-do-applescript 1 1)
  (ns-emacs-info-panel 0 0)
  (ns-font-name 1 1)
  (ns-frame-edges 0 2)
  (ns-frame-geometry 0 1)
  (ns-frame-list-z-order 0 1)
  (ns-frame-restack 2 3)
  (ns-get-resource 2 2)
  (ns-get-selection 2 2)
  (ns-hide-emacs 1 1)
  (ns-hide-others 0 0)
  (ns-list-colors 0 1)
  (ns-list-services 0 0)
  (ns-mouse-absolute-pixel-position 0 0)
  (ns-own-selection-internal 2 2)
  (ns-perform-service 2 2)
  (ns-popup-color-panel 0 1)
  (ns-process-is-accessibility-trusted 0 0)
  (ns-progress-indicator 1 1)
  (ns-read-file-name 1 5)
  (ns-request-user-attention 1 1)
  (ns-reset-menu 0 0)
  (ns-selection-exists-p 0 1)
  (ns-selection-owner-p 0 1)
  (ns-send-items 1 1)
  (ns-set-mouse-absolute-pixel-position 2 2)
  (ns-set-resource 3 3)
  (ns-show-character-palette 0 0)
  (ns-unblock-system-sleep 1 1)
 )
 :variables (
  (ns-alternate-modifier . meta)
  (ns-antialias-text . t)
  (ns-auto-hide-menu-bar . nil)
  (ns-click-through . t)
  (ns-command-modifier . super)
  (ns-confirm-quit . nil)
  (ns-control-modifier . control)
  (ns-drag-motion-function . ns-handle-drag-motion)
  (ns-function-modifier . none)
  (ns-icon-type-alist . (t))
  (ns-input-file . nil)
  (ns-input-font . nil)
  (ns-input-fontsize . nil)
  (ns-input-line . nil)
  (ns-input-spi-arg . nil)
  (ns-input-spi-name . nil)
  (ns-mwheel-line-height . nil)
  (ns-reg-to-script . nil)
  (ns-right-alternate-modifier . left)
  (ns-right-command-modifier . left)
  (ns-right-control-modifier . left)
  (ns-scroll-event-delta-factor . 1.0)
  (ns-sent-selection-hooks . nil)
  (ns-use-fullscreen-animation . nil)
  (ns-use-mwheel-acceleration . t)
  (ns-use-mwheel-momentum . t)
  (ns-use-native-fullscreen . t)
  (ns-use-proxy-icon . t)
  (ns-use-srgb-colorspace . t)
  (ns-use-thin-smoothing . nil)
  (ns-version-string . :string)
  (ns-working-text . nil)
 ))
